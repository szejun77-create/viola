  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "@electric-sql/pglite": "^0.3.16"
  },
  "packageManager": "pnpm@10.32.1"
}
