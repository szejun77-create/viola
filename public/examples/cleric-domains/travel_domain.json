{
  "id": "travel_domain",
  "name": "旅行领域",
  "category": "class",
  "mode": "passive",
  "parameters": {},
  "outputs": [],
  "description": "获得生存作为本职技能。获得旅行领域独立法术表：自发施法，基础施法者等级为牧师等级，法术位由DM配置。行动自如次数为角色总等级，每次消耗1次，生成1轮行动自如备忘；适用条件由现场判断，恢复由DM手动处理。",
  "grantsCasting": {
    "id": "travel-domain",
    "name": "旅行领域",
    "levelClass": "cleric",
    "spellcastingMode": "spontaneous"
  },
  "resources": {
    "freedom_of_movement": {
      "label": "行动自如",
      "initial": "level",
      "min": "0",
      "max": "level",
      "integer": true,
      "playerEditable": false
    }
  },
  "actions": [
    {
      "id": "use_freedom",
      "label": "使用行动自如",
      "playerUsable": true,
      "when": "resources.freedom_of_movement > 0",
      "changes": [
        {
          "target": "resources.freedom_of_movement",
          "value": "resources.freedom_of_movement - 1"
        }
      ],
      "createTimedEffect": {
        "name": "行动自如",
        "text": "你获得行动自如法术的效果，持续1回合。具体适用条件与结算由现场判断。",
        "remaining": "1",
        "category": "combat"
      }
    }
  ],
  "notes": [
    {
      "text": "生存作为本职：请DM在牧师职业本职技能中勾选生存。",
      "category": "noncombat"
    }
  ]
}
