{
  "id": "healing_belt",
  "name": "愈合腰带",
  "category": "item",
  "mode": "passive",
  "equipmentSlot": "waist",
  "parameters": {},
  "outputs": [
    {
      "target": "skill.heal",
      "value": "2",
      "duration": "short",
      "bonusType": "unnamed"
    }
  ],
  "resources": {
    "energy": {
      "label": "治疗能量",
      "initial": 3,
      "min": "0",
      "max": "3",
      "integer": true,
      "playerEditable": false
    }
  },
  "notes": [
    {
      "text": "你可以用正能量治疗身边一个人：消耗1格能量治疗2d8，2格治疗3d8，3格治疗4d8；治疗由现场结算。",
      "when": "resources.energy > 0",
      "category": "combat"
    }
  ],
  "actions": [
    {
      "id": "heal_1",
      "label": "消耗1格：治疗2d8",
      "playerUsable": true,
      "when": "resources.energy >= 1",
      "changes": [
        {
          "target": "resources.energy",
          "value": "resources.energy - 1"
        }
      ]
    },
    {
      "id": "heal_2",
      "label": "消耗2格：治疗3d8",
      "playerUsable": true,
      "when": "resources.energy >= 2",
      "changes": [
        {
          "target": "resources.energy",
          "value": "resources.energy - 2"
        }
      ]
    },
    {
      "id": "heal_3",
      "label": "消耗3格：治疗4d8",
      "playerUsable": true,
      "when": "resources.energy >= 3",
      "changes": [
        {
          "target": "resources.energy",
          "value": "resources.energy - 3"
        }
      ]
    }
  ]
}
