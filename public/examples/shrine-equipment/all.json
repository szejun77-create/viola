        "label": "消耗2格：治疗3d8",
        "playerUsable": true,
        "when": "resources.energy >= 2",
        "changes": [
          {
            "target": "resources.energy",
            "value": "resources.energy - 2"
          }
        ]
      },
      {
        "id": "heal_3",
        "label": "消耗3格：治疗4d8",
        "playerUsable": true,
        "when": "resources.energy >= 3",
        "changes": [
          {
            "target": "resources.energy",
            "value": "resources.energy - 3"
          }
        ]
      }
    ]
