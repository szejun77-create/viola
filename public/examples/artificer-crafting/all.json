    "resources": {
      "uses": {
        "label": "快捷机关术",
        "initial": 1,
        "min": "0",
        "max": "1",
        "integer": true,
        "playerEditable": false
      }
    },
    "actions": [
      {
        "id": "use",
        "label": "使用快捷机关术",
        "playerUsable": true,
        "when": "resources.uses > 0",
        "changes": [
          {
            "target": "resources.uses",
            "value": "resources.uses - 1"
          }
        ]
      }
    ]
  },
