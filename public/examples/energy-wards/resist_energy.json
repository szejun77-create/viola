{
  "id": "resist_energy",
  "name": "抵抗能量伤害",
  "category": "spell",
  "mode": "toggle",
  "parameters": {
    "energy": {
      "label": "本次施法选择的能量",
      "type": "choice",
      "default": "acid",
      "options": [
        "acid",
        "cold",
        "electricity",
        "fire",
        "sonic"
      ],
      "playerEditable": true
    }
  },
  "outputs": [],
  "description": "学派：防护系\n等级：牧师2级、巫女2级\n法术成分：言语、姿势、法器\n施法时间：1个标准动作\n距离：接触\n目标：所有友军（包括自己）\n持续时间：每施法者等级10分钟（共{100 * caster.level}轮）\n在下方施法确认区选择酸、寒冷、电击、火或音波。获得对应能量的{MIN(10 * FLOOR((caster.level + 1) / 4), 30)}点抗性，并保护装备；仅吸收能量伤害，不免疫其他负面效果。",
  "spell": {
    "classLevels": {
      "cleric": 2,
      "shrine-maiden": 2
    },
    "castAction": "cast",
    "castParameters": [
      "energy"
    ]
  },
  "grant": {
    "name": "抵抗能量伤害效果",
    "group": "ally",
    "mode": "all",
    "defaultAccepted": true,
    "includeSelf": true,
    "outputs": [
      {
        "target": "acidResistance",
        "duration": "short",
        "bonusType": "unnamed",
        "value": "MIN(10 * FLOOR((caster.level + 1) / 4), 30)",
        "when": "params.energy = \"acid\""
      },
      {
        "target": "coldResistance",
        "duration": "short",
        "bonusType": "unnamed",
        "value": "MIN(10 * FLOOR((caster.level + 1) / 4), 30)",
        "when": "params.energy = \"cold\""
      },
      {
        "target": "electricityResistance",
        "duration": "short",
        "bonusType": "unnamed",
        "value": "MIN(10 * FLOOR((caster.level + 1) / 4), 30)",
        "when": "params.energy = \"electricity\""
      },
      {
        "target": "fireResistance",
        "duration": "short",
        "bonusType": "unnamed",
        "value": "MIN(10 * FLOOR((caster.level + 1) / 4), 30)",
        "when": "params.energy = \"fire\""
      },
      {
        "target": "sonicResistance",
        "duration": "short",
        "bonusType": "unnamed",
        "value": "MIN(10 * FLOOR((caster.level + 1) / 4), 30)",
        "when": "params.energy = \"sonic\""
      }
    ],
    "notes": [
      {
        "text": "选定能量：{params.energy}；抗性：{MIN(10 * FLOOR((caster.level + 1) / 4), 30)}。也保护装备，但不免疫该能量的其他负面效果。",
        "category": "combat"
      }
    ]
  },
  "actions": [
    {
      "id": "cast",
      "label": "施放抵抗能量伤害",
      "playerUsable": true,
      "changes": [
        {
          "target": "module.enabled",
          "value": "true"
        }
      ],
      "createTimedEffect": {
        "name": "抵抗能量伤害",
        "text": "选定能量：{params.energy}；抗性：{MIN(10 * FLOOR((caster.level + 1) / 4), 30)}点；持续{100 * caster.level}轮。",
        "remaining": "100 * caster.level",
        "expiresModule": true
      }
    }
  ]
}
